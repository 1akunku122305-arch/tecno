# ------------------------------------------------------------------
# Mentora environment variables (copy to .env.local and fill in)
# ------------------------------------------------------------------

# Supabase project URL, e.g. https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon/public key (safe for the browser — NEVER use the service_role key here)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: public site URL used in auth redirects (Set on Vercel automatically)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
